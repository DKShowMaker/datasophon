{
    "name": "DMDB",
    "label": "DMDB",
    "description": "自主研发的大型通用关系型数据库",
    "version": "20240712_x86_rh7_64",
    "sortNum": 24,
    "dependencies": [],
    "packageName": "dm8.tar.gz",
    "decompressPackageName": "dm8",
    "roles": [
    {
      "name": "DMDBService",
      "label": "DMDBService",
      "roleType": "master",
      "cardinality": "1+",
      "sortNum": 1,
      "logFile": "/dmdbms/log/dm8.log",
      "jmxPort": 9200,
      "startRunner": {
        "timeout": "300",
        "program": "bin/start.sh",
        "args": []
      },
      "stopRunner": {
        "timeout": "60",
        "program": "bin/stop.sh",
        "args": []
      },
      "statusRunner": {
        "timeout": "60",
        "program": "bin/status.sh",
        "args": []
      }
    }
  ],
    "configWriter": {
      "generators": [
        {
          "filename": "start.sh",
          "configFormat": "custom",
          "outputDirectory": "bin",
          "templateName": "dmdb.ftl",
          "includeParams":[
            "INSTALL_TYPE",
            "INSTALL_PATH",
            "INIT_DB",
            "PORT_NUM",
            "PATH",
            "DB_NAME",
            "INSTANCE_NAME",
            "EXTENT_SIZE",
            "PAGE_SIZE",
            "LOG_SIZE",
	          "CASE_SENSITIVE",
	          "CHARSET",
            "SYSDBA_PWD",
            "SYSAUDITOR_PWD",
            "SYSSSO_PWD",
            "SYSDBO_PWD",
            "CREATE_DB_SERVICE",
            "STARTUP_DB_SERVICE"
          ]
        }
      ]
    },
    "parameters": [
    {
      "name": "INSTALL_TYPE",
      "label": "安装类型",
      "description": "安装程序组件类型，取值 0、1、2，0 表示安装全部，1 表示安装服务器，2 表示安装客户端",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "0"
    },
    {
      "name": "INSTALL_PATH",
      "label": "安装路径",
      "description": "数据库安装路径",
      "configType": "map",
      "required": true,
      "separator": " ",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "/opt/datasophon/dm8/dmdbms"
    },
    {
      "name": "INIT_DB",
      "label": "是否初始化数据库",
      "description": "是否初始化库，取值 Y/N",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "Y"
    },
    {
      "name": "PORT_NUM",
      "label": "数据库访问端口",
      "description": "数据库访问端口",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "5236"
    },
    {
      "name": "PATH",
      "label": "初始数据库存放的路径",
      "description": "初始数据库存放的路径，不允许为空",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "/opt/datasophon/dm8/dmdbms/data"
    },
    {
      "name": "DB_NAME",
      "label": "初始化数据库名字",
      "description": "初始化数据库名字，默认是 DAMENG，不超过 128 个字符",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "DAMENG"
    },
    {
      "name": "INSTANCE_NAME",
      "label": "初始化数据库实例名字",
      "description": "初始化数据库实例名字，默认是 DMSERVER，不超过 128 个字符",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "DMSERVER"
    },
    {
      "name": "EXTENT_SIZE",
      "label": "数据文件使用的簇大小",
      "description": "数据文件使用的簇大小，只能是 16 页或 32 页之一，缺省使用 16 页",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "16"
    },
    {
      "name": "PAGE_SIZE",
      "label": "数据文件使用的页大小",
      "description": "数据文件使用的页大小，缺省使用 8K，只能是 4K、8K、16K 或 32K 之一",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "8"
    },
    {
      "name": "LOG_SIZE",
      "label": "日志文件使用的簇大小",
      "description": "日志文件使用的簇大小，默认是 256，取值范围 64 和 2048 之间的整数",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "256"
    },
    {
      "name": "CASE_SENSITIVE",
      "label": "是否大小写敏感",
      "description": "标识符大小写敏感，默认值为 Y。只能是’Y’, ’y’, ’N’, ’n’, ’1’, ’0’之一",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "Y"
    },
    {
      "name": "CHARSET",
      "label": "字符集选项",
      "description": "字符集选项，默认值为 0。0 代表 GB18030,1 代表 UTF-8,2 代表韩文字符集 EUC-KR",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "0"
    },
    {
      "name": "SYSDBA_PWD",
      "label": "初始化时设置 SYSDBA 的密码",
      "description": "初始化时设置 SYSDBA 的密码，默认为 SYSDBA_PWD，长度在 9 到 48 个字符之间",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "SYSDBA_PWD"
    },
    {
      "name": "SYSAUDITOR_PWD",
      "label": "初始化时设置 SYSAUDITOR 的密码",
      "description": "初始化时设置 SYSAUDITOR 的密码，默认为 SYSAUDITOR_PWD，长度在 9 到 48 个字符之间",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "SYSAUDITOR_PWD"
    },
    {
      "name": "SYSSSO_PWD",
      "label": "初始化时设置 SYSSSO 的密码",
      "description": "初始化时设置 SYSSSO 的密码，默认为 SYSSSO_PWD ，长度在 9 到 48 个字符之间，仅在安全版本下可见和可设置",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "SYSSSO_PWD"
    },
    {
      "name": "SYSDBO_PWD",
      "label": "初始化时设置 SYSDBO 的密码",
      "description": "初始化时设置 SYSDBO 的密码，默认为 SYSDBO_PWD 长度在 9 到 48 个字符之间，仅在安全版本下可见和可设置",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "SYSDBO_PWD"
    },
    {
      "name": "CREATE_DB_SERVICE",
      "label": "是否创建数据库实例的服务",
      "description": "是否创建数据库实例的服务，值 Y/N y/n，不允许为空，不初始化数据库将忽略此节点。非 root 用户不能创建数据库服务。",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "Y"
    },
    {
      "name": "STARTUP_DB_SERVICE",
      "label": "是否启动数据库",
      "description": "是否启动数据库，值 Y/N y/n，不允许为空，不创建数据库服务将忽略此节点。",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "Y"
    }
  ]
}
